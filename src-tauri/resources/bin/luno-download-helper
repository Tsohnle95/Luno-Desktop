#!/bin/sh
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
export PATH="$HERE:$PATH"
TARGET="${1:-}"
SOURCE="${2:-${LUNO_DOWNLOAD_SOURCE:-}}"
if [ -z "$TARGET" ]; then
  echo "download helper: missing output path" >&2
  exit 2
fi
if [ -z "$SOURCE" ]; then
  echo "download helper: no download source (URL or search query) was provided" >&2
  exit 2
fi
if [ -x "$HERE/yt-dlp" ]; then
  DOWNLOADER="$HERE/yt-dlp"
elif command -v yt-dlp >/dev/null 2>&1; then
  DOWNLOADER="yt-dlp"
else
  echo "download helper: yt-dlp is not available" >&2
  exit 1
fi
# Accumulate the argument vector with `set --` so every value stays exactly
# one word. `$FF_LOCATION_FLAG` used to expand UNQUOTED here, which split any
# bundle path containing spaces ("/Applications/Luno Desktop.app/...") into a
# truncated --ffmpeg-location plus a phantom source URL — yt-dlp then ran
# without ffmpeg and every preview/download postprocessing step failed with
# exit 1 ("preview download helper failed", 2026-09-09).
# Ignore machine/user yt-dlp configuration. A configured download archive,
# --simulate, or output path can otherwise return success without creating the
# one output file this helper owns.
set -- --ignore-config --no-playlist --newline --progress-delta 0.25
# yt-dlp currently enables Deno by default. Enable Node when the app already
# has it on PATH so YouTube's JavaScript challenges can be solved without
# adding an unmanaged runtime dependency to the bundle.
NODE_RUNTIME=$(command -v node 2>/dev/null || true)
if [ -n "$NODE_RUNTIME" ]; then
  set -- "$@" --js-runtimes "node:$NODE_RUNTIME"
fi
if [ "${LUNO_PREVIEW:-0}" = "1" ]; then
  # Preview progress is parsed from machine-readable byte counters. The
  # status field keeps source lookup and post-processing indeterminate, while
  # total_bytes_estimate covers fragmented media without inventing a total.
  set -- "$@" --progress-template 'download:LUNO_BYTES=%(progress.downloaded_bytes)s;LUNO_TOTAL=%(progress.total_bytes)s;LUNO_ESTIMATE=%(progress.total_bytes_estimate)s;LUNO_STATUS=%(progress.status)s'
else
  # Production download jobs retain their existing percentage contract; the
  # coordinator reserves the final slice for validation and promotion.
  set -- "$@" --progress-template 'download:LUNO_PROGRESS=%(progress._percent_str)s'
fi
# The coordinator can retry a YouTube 403 through its token-free HLS audio
# rendition. Keep the normal provider-neutral selector as the first attempt.
FORMAT_SELECTOR="${LUNO_DOWNLOAD_FORMAT:-bestaudio/best}"
set -- "$@" -f "$FORMAT_SELECTOR"
if [ "${LUNO_PREVIEW:-0}" != "1" ]; then
  # Force AAC encoding even when the HLS input already contains AAC. yt-dlp
  # otherwise chooses stream-copy, which cannot be combined with the loudness
  # filter and fails during post-processing.
  set -- "$@" -x --audio-format m4a --audio-quality 0 --embed-thumbnail --embed-metadata --convert-thumbnails jpg --ppa 'ExtractAudio+ffmpeg_o:-c:a aac -ar 44100 -ac 2 -af loudnorm=I=-14:LRA=11:TP=-1.5'
fi
if [ -x "$HERE/ffmpeg" ]; then
  set -- "$@" --ffmpeg-location "$HERE"
fi
TARGET_DIR=$(dirname "$TARGET")
TARGET_NAME=$(basename "$TARGET")
STAGING_ROOT="$TARGET_DIR/.luno-download-staging"
if [ -L "$STAGING_ROOT" ]; then
  echo "download helper: staging path must not be a symlink" >&2
  exit 1
fi
if [ ! -d "$STAGING_ROOT" ]; then
  mkdir "$STAGING_ROOT" 2>/dev/null || {
    if [ ! -d "$STAGING_ROOT" ] || [ -L "$STAGING_ROOT" ]; then
      echo "download helper: staging directory is unavailable" >&2
      exit 1
    fi
  }
fi
if [ -L "$STAGING_ROOT" ]; then
  echo "download helper: staging path must not be a symlink" >&2
  exit 1
fi
STAGING_DIR="$STAGING_ROOT/$TARGET_NAME.$$"
if ! mkdir "$STAGING_DIR" 2>/dev/null; then
  echo "download helper: per-download staging directory is unavailable" >&2
  exit 1
fi
TMP="$STAGING_DIR/$TARGET_NAME.part"
cleanup_staging() {
  rm -f "$TMP".*
  rmdir "$STAGING_DIR" 2>/dev/null || true
  rmdir "$STAGING_ROOT" 2>/dev/null || true
}
rm -f "$TMP".*
set -- "$@" -o "$TMP.%(ext)s" -- "$SOURCE"
"$DOWNLOADER" "$@"
status=$?
if [ "$status" -ne 0 ]; then
  cleanup_staging
  exit "$status"
fi
found=""
for f in "$TMP".*; do
  [ -f "$f" ] && found="$f"
done
if [ -z "$found" ]; then
  echo "download helper: download produced no output file" >&2
  cleanup_staging
  exit 1
fi
mv "$found" "$TARGET" || { cleanup_staging; exit 1; }
cleanup_staging
exit 0
