#!/bin/sh
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
export PATH="$HERE:$PATH"
TARGET="${1:-}"
SOURCE="${2:-${LUNO_DOWNLOAD_SOURCE:-}}"
if [ -z "$TARGET" ]; then
  echo "download helper: missing output path" >&2
  exit 2
fi
if [ -z "$SOURCE" ]; then
  echo "download helper: no download source (URL or search query) was provided" >&2
  exit 2
fi
FF_LOCATION_FLAG=""
if [ -x "$HERE/ffmpeg" ]; then
  FF_LOCATION_FLAG="--ffmpeg-location $HERE"
fi
TMP="$TARGET.part"
rm -f "$TMP".*
if [ -x "$HERE/yt-dlp" ]; then
  "$HERE/yt-dlp" --no-playlist --newline --progress-delta 0.25 --progress-template 'download:LUNO_PROGRESS=%(progress._percent_str)s' -f 'bestaudio/best' -x --audio-format m4a --audio-quality 0 --embed-thumbnail --embed-metadata --convert-thumbnails jpg --ppa 'ExtractAudio+ffmpeg_o:-ar 44100 -ac 2 -af loudnorm=I=-14:LRA=11:TP=-1.5' $FF_LOCATION_FLAG -o "$TMP.%(ext)s" -- "$SOURCE"
else
  if command -v yt-dlp >/dev/null 2>&1; then
    yt-dlp --no-playlist --newline --progress-delta 0.25 --progress-template 'download:LUNO_PROGRESS=%(progress._percent_str)s' -f 'bestaudio/best' -x --audio-format m4a --audio-quality 0 --embed-thumbnail --embed-metadata --convert-thumbnails jpg --ppa 'ExtractAudio+ffmpeg_o:-ar 44100 -ac 2 -af loudnorm=I=-14:LRA=11:TP=-1.5' $FF_LOCATION_FLAG -o "$TMP.%(ext)s" -- "$SOURCE"
  else
    echo "download helper: yt-dlp is not available" >&2
    exit 1
  fi
fi
status=$?
if [ "$status" -ne 0 ]; then
  rm -f "$TMP".*
  exit "$status"
fi
found=""
for f in "$TMP".*; do
  [ -f "$f" ] && found="$f"
done
if [ -z "$found" ]; then
  echo "download helper: download produced no output file" >&2
  rm -f "$TMP".*
  exit 1
fi
mv "$found" "$TARGET" || { rm -f "$TMP".*; exit 1; }
rm -f "$TMP".*
exit 0
