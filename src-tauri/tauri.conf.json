{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luno",
  "version": "0.1.0",
  "identifier": "com.ty.luno",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luno",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/videos"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "resources": {
      "../release/desktop-binaries.json": "desktop-binaries.json",
      "../release/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/bin": "bin"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}